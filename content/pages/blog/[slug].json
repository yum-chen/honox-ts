{
  "title": "Blog Post Detail Template",
  "content": [
    {
      "blockType": "anchor",
      "href": "/blog/by-author/{{post.author}}",
      "style": "display: inline-flex; align-items: center; text-decoration: none",
      "children": [
        {
          "blockType": "avatar",
          "size": "md",
          "variant": "solid",
          "name": "{{post.author}}"
        }
      ]
    }
  ]
}
